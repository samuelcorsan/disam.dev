---
import Portfolio from "@/layouts/portfolio.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import Hero from "@/components/hero.astro";
import About from "@/components/about.astro";
import Projects from "@/components/projects.astro";
import ContactDock from "@/components/contact-dock.astro";
---
<Portfolio>
  <div class="portfolio">
    <div class="theme-switch-position"><ThemeToggle /></div>
    <main class="portfolio-content">
      <Hero />
      <About />
      <Projects />
      <footer class="portfolio-footer">
        <h2>Contact</h2>
        <p>Always happy to talk about an idea, a project, or what you&apos;re building.</p>
        <ContactDock />
      </footer>
    </main>
  </div>
</Portfolio>
