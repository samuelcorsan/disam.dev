---
import { projects } from "@/lib/projects";
import { projectStories } from "@/lib/project-stories";
import { hackspainSponsors } from "@/lib/hackspain-sponsors";
import StoryText from "./story-text.astro";
---
<section class="portfolio-projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading">Projects</h2>
  <ul class="project-list">
    {projects.map((project) => {
      const story = projectStories[project.tone];
      const panelId = `project-story-${project.tone}`;
      const triggerId = `project-trigger-${project.tone}`;
      return (
        <li class="project-accordion" data-open="false" data-instant="false">
          <h3 class="project-heading">
            <button id={triggerId} type="button" class="project-row project-trigger" aria-expanded="false" aria-controls={panelId}>
              {project.logo && (
                <span class="project-mark" aria-hidden="true">
                  <img src={project.logo} alt="" width="30" height="30" />
                </span>
              )}
              <span class="project-description">
                <span class="project-name">{project.name}</span>{" "}
                <span class="project-role">{project.description}</span>
              </span>
              <span class="project-date">{project.year} <span>({project.age}yrs old)</span></span>
              <span class="project-affordance">
                <span data-story-label>Read story</span>
                <svg class="project-disclosure" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </button>
          </h3>
          <div id={panelId} role="region" aria-labelledby={triggerId} aria-hidden="true" inert class="project-story-panel" style="height: 0">
            <div class="project-story">
              {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {project.tone === "hackspain" && (
                <p>Backed by {hackspainSponsors.map((sponsor, index) => (
                  <span>
                    <a href={`https://${sponsor.domain}`} target="_blank" rel="noopener noreferrer">{sponsor.name}</a>
                    {index < hackspainSponsors.length - 2 ? ", " : index === hackspainSponsors.length - 2 ? ", and " : ", among others."}
                  </span>
                ))}</p>
              )}
              {story.tech && <p class="project-technologies">{story.tech.join(" · ")}</p>}
              {story.videos && (
                <div class="project-story-gallery">
                  {story.videos.map((video) => (
                    <figure>
                      <video controls playsinline preload="none" aria-label={video.caption}>
                        <source src={video.src} type="video/mp4" />
                        <a href={video.src}>Watch {video.caption}</a>
                      </video>
                      <figcaption>{video.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
              {story.images && (
                <div class={`project-story-gallery${story.images.length === 1 ? " project-story-gallery-single" : ""}`}>
                  {story.images.map((photo) => (
                    <figure>
                      <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open ${photo.caption ?? project.name} image`}>
                        <img src={photo.src} alt={photo.caption ?? project.name} width="800" height="500" loading="lazy" decoding="async" />
                      </a>
                      <figcaption>{photo.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
              {story.chapters && (
                <div class="project-chapters">
                  {story.chapters.map((chapter) => {
                    if (chapter.type === "h") return <h4>{chapter.text}</h4>;
                    if (chapter.type === "quote") return <blockquote>{chapter.text}</blockquote>;
                    return <p><StoryText text={chapter.text} glossary={story.glossary} /></p>;
                  })}
                </div>
              )}
              <div class="project-story-actions">
                {project.href && <a href={project.href} target="_blank" rel="noopener noreferrer">{project.tone === "caotic" ? "Watch the trailer" : project.tone === "syntara" ? "View on GitHub" : `Visit ${project.name}`} <span aria-hidden="true">↗</span></a>}
                <button type="button" data-close-story>Close story <span aria-hidden="true">↑</span></button>
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</section>
<script>
  import "@/scripts/projects";
</script>
